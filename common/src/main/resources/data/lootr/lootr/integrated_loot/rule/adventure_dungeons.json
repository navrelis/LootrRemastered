{
  "required_mods": ["adventuredungeons"],
  "entries": [
    { "tables": ["adventuredungeons:chests/**gravel*", "adventuredungeons:chests/**_pot", "adventuredungeons:chests/**_pot_*"], "exclude": true },
    { "tables": ["adventuredungeons:chests/**rare*", "adventuredungeons:chests/**reward*"], "pool": "lootr:overworld_rare", "rolls": 2 },
    { "tables": ["adventuredungeons:chests/**library*"], "pool": "lootr:overworld_rare", "rolls": 1 },
    { "tables": ["adventuredungeons:chests/**barrel*"], "pool": "lootr:village", "rolls": { "min": 0, "max": 1 } },
    { "tables": ["adventuredungeons:chests/**helpful*"], "pool": "lootr:overworld_common", "rolls": { "min": 0, "max": 1 } },
    { "tables": ["adventuredungeons:chests/**", "adventuredungeons:ruins/*"], "pool": "lootr:overworld_common", "rolls": 1 }
  ]
}
