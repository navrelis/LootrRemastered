    { "tables": ["mvs:houses_uncommon", "mvs:houses_desert"], "pool": "lootr:village", "rolls": 1 },
    { "tables": ["mvs:abandoned", "mvs:swamps", "mvs:mushroom_pond", "mvs:floating_islands"], "pool": "lootr:overworld_common", "rolls": { "min": 0, "max": 1 } },
    {
      "tables": [
        "mvs:general",
        "mvs:cartographer_tower",
        "mvs:cathedral_base",
        "mvs:cathedral_common",
        "mvs:jungle_tower",
