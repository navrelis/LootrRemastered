{
  "required_mods": ["structory"],
  "entries": [
    { "tables": ["structory:mood/**", "structory:outcast/low", "structory:extra/copper", "structory:**junk*"], "exclude": true },
    { "tables": ["structory:**treasure"], "pool": "lootr:overworld_rare", "rolls": 2 },
    { "tables": ["structory:library/high", "structory:ruin/swamp/loot"], "pool": "lootr:overworld_rare", "rolls": 1 },
    { "tables": ["structory:outcast/boat/*"], "pool": "lootr:ocean", "rolls": 1 },
    { "tables": ["structory:outcast/farm_ruin", "structory:ruin/taiga/illager_low"], "pool": "lootr:village", "rolls": { "min": 0, "max": 1 } },
    { "tables": ["structory:outcast/settlement"], "pool": "lootr:village", "rolls": 1 },
    { "tables": ["structory:harvest/**", "structory:library/low", "structory:outcast/**", "structory:ruin/**"], "pool": "lootr:overworld_common", "rolls": 1 }
  ]
}
