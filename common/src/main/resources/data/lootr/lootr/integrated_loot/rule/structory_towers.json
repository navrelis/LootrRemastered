{
  "required_mods": ["structory_towers"],
  "entries": [
    {
      "tables": [
        "structory_towers:potions*",
        "structory_towers:potions/*",
        "structory_towers:horse_equipment",
        "structory_towers:workshop_minecart",
        "structory_towers:basic/crimson_basic",
        "structory_towers:basic/fortress_basic"
      ],
      "exclude": true
    },
    { "tables": ["structory_towers:end_tower"], "pool": "lootr:end", "rolls": 1 },
    { "tables": ["structory_towers:sword_portal"], "pool": "lootr:nether", "rolls": 1 },
    { "tables": ["structory_towers:top/crimson_top", "structory_towers:top/fortress_top", "structory_towers:top/warped_top"], "pool": "lootr:nether", "rolls": 2 },
    { "tables": ["structory_towers:top/lighthouse_top", "structory_towers:top/ocean_pillar_top"], "pool": "lootr:ocean", "rolls": 2 },
    { "tables": ["structory_towers:basic/lighthouse_basic", "structory_towers:basic/ocean_pillar_basic"], "pool": "lootr:ocean", "rolls": { "min": 0, "max": 1 } },
    { "tables": ["structory_towers:basic/warped_basic"], "pool": "lootr:nether", "rolls": { "min": 0, "max": 1 } },
    { "tables": ["structory_towers:top/*"], "pool": "lootr:overworld_rare", "rolls": 2 },
    { "tables": ["structory_towers:toadstool"], "pool": "lootr:overworld_rare", "rolls": 1 },
    { "tables": ["structory_towers:basic/*"], "pool": "lootr:overworld_common", "rolls": { "min": 0, "max": 1 } }
  ]
}
