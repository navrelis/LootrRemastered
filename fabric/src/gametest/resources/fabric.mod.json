{
  "schemaVersion": 1,
  "id": "lootr_gametest",
  "version": "${version}",
  "name": "Lootr Remastered Game Tests",
  "description": "In-game tests for Lootr Remastered. Development only; not part of the release.",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "noobanidus.mods.lootr.fabric.gametest.FabricTestPlatform"
    ],
    "fabric-gametest": [
      "noobanidus.mods.lootr.gametest.LootrSmokeTests",
      "noobanidus.mods.lootr.gametest.LootrDefectFixTests",
      "noobanidus.mods.lootr.gametest.LootrItemBanTests",
      "noobanidus.mods.lootr.gametest.LootrIntegratedLootTests",
      "noobanidus.mods.lootr.gametest.LootrCoreTests",
      "noobanidus.mods.lootr.gametest.LootrVerifyTests",
      "noobanidus.mods.lootr.gametest.LootrPerformanceFixTests",
      "noobanidus.mods.lootr.gametest.LootrLocateTests"
    ]
  },
  "mixins": [
    "lootr_gametest.mixins.json"
  ],
  "depends": {
    "lootr": "*"
  }
}
