{
  "schemaVersion": 1,
  "id": "lootr",
  "version": "${version}",
  "name": "Lootr Remastered",
  "description": "${mod_description}",
  "authors": [
    "navrelis"
  ],
  "contributors": [
    "Noobanidus (original Lootr)",
    "ZestyBlaze (original Lootr)",
    "embeddedt (original Lootr)"
  ],
  "accessWidener": "lootr.accesswidener",
  "contact": {
    "homepage": "https://github.com/navrelis/LootrRemastered",
    "sources": "https://github.com/navrelis/LootrRemastered",
    "issues": "https://github.com/navrelis/LootrRemastered/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "noobanidus.mods.lootr.fabric.Lootr"
    ],
    "client": [
      "noobanidus.mods.lootr.fabric.LootrClient"
    ],
    "modmenu": [
      "noobanidus.mods.lootr.fabric.integration.ModMenuIntegration"
    ],
    "jade": [
      "noobanidus.mods.lootr.common.integration.jade.LootrWailaPlugin"
    ]
  },
  "mixins": [
    "lootr-common.mixins.json",
    "lootr-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "fabric": ">=0.100.3",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "cloth-config": ">=15.0.127"
  },
  "breaks": {
    "lootintegrations": "*"
  }
}
